[Unit]
Description=Nomad Packet Capture inline tap (bridge built-in Ethernet + %I)
# Unplugging the adapter stops this unit, which removes the bridge.
BindsTo=sys-subsystem-net-devices-%i.device
After=sys-subsystem-net-devices-%i.device NetworkManager.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/lib/nomad-packet-capture/tap-helper up %I
ExecStop=/usr/lib/nomad-packet-capture/tap-helper down %I
