// Nomad Packet Capture: local users in the "netdev" group may start and stop
// the inline-tap bridge unit, nomad-packet-capture-tap@<iface>.service.
// Nothing else is allowed.
polkit.addRule(function (action, subject) {
  if (action.id == "org.freedesktop.systemd1.manage-units" && subject.isInGroup("netdev")) {
    var unit = action.lookup("unit");
    var verb = action.lookup("verb");
    if ((verb == "start" || verb == "stop") &&
        /^nomad-packet-capture-tap@[A-Za-z0-9_.-]+\.service$/.test(unit)) {
      return polkit.Result.YES;
    }
  }
});
