#!/bin/sh
# APPLaunch entry point for Nomad Packet Capture (also installed as
# /usr/bin/nomad-packet-capture for use over SSH: nomad-packet-capture --status).
# APPLaunch runs Exec without a shell, so environment setup lives here.
APP_DIR=/usr/share/APPLaunch/lib/nomad-packet-capture
export PYTHONPATH="$APP_DIR${PYTHONPATH:+:$PYTHONPATH}"
export PYGAME_HIDE_SUPPORT_PROMPT=1 SDL_VIDEODRIVER=dummy SDL_AUDIODRIVER=dummy
export PATH="${PATH:-/usr/bin:/bin}:/usr/sbin:/sbin"
[ -z "$XDG_RUNTIME_DIR" ] && export XDG_RUNTIME_DIR="/run/user/$(id -u)"
[ -z "$HOME" ] && export HOME="$(getent passwd "$(id -u)" | cut -d: -f6)"
# Renamed from tnt-packet-capture (TNT brand): move the old settings and files over once.
for p in .config/tnt-packet-capture:.config/nomad-packet-capture TNT-Captures:Nomad-Captures; do
  o="$HOME/${p%%:*}"; n="$HOME/${p#*:}"
  [ -e "$o" ] && [ ! -e "$n" ] && mv "$o" "$n"
done
cd "$APP_DIR" || exit 1
exec python3 -m nomadcap "$@"
