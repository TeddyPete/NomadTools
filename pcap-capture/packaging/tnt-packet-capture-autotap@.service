[Unit]
Description=TNT Packet Capture: auto-start the inline tap on USB adapter %I
After=sys-subsystem-net-devices-%i.device

[Service]
Type=oneshot
# Runs as the device's desktop user (APPLaunch runs apps as pi).
User=pi
Environment=XDG_RUNTIME_DIR=/run/user/1000 HOME=/home/pi
ExecStart=/usr/bin/tnt-packet-capture --autotap %I
