#!/bin/sh
# NAT for TNT WiFi Share (runs as root from tnt-wifi-share-nat@.service).
#   nat-helper start|stop <iface>
# start: remember ip_forward, turn it on, add an nftables table that
#        masquerades traffic from <iface> going out any other interface.
# stop:  remove the table; when no app table is left, put ip_forward back.
# Nothing is written to disk outside /run, so a reboot clears it all.
set -eu
action="${1:-}"
dev="${2:-}"
case "$dev" in
  ""|*[!A-Za-z0-9_.-]*) echo "bad interface name" >&2; exit 2 ;;
esac
RUN=/run/tnt-wifi-share
T="tnt_share_$(printf %s "$dev" | tr -c 'A-Za-z0-9_' '_')"
mkdir -p "$RUN"
case "$action" in
  start)
    [ -f "$RUN/ip_forward" ] || cat /proc/sys/net/ipv4/ip_forward > "$RUN/ip_forward"
    echo 1 > /proc/sys/net/ipv4/ip_forward
    nft delete table ip "$T" 2>/dev/null || true
    nft -f - <<NFT
table ip $T {
  chain forward {
    type filter hook forward priority -10; policy accept;
    iifname "$dev" accept
    oifname "$dev" ct state established,related accept
  }
  chain postrouting {
    type nat hook postrouting priority 110; policy accept;
    iifname "$dev" oifname != "$dev" masquerade
  }
}
NFT
    ;;
  stop)
    nft delete table ip "$T" 2>/dev/null || true
    if ! nft list tables 2>/dev/null | grep -q 'tnt_share_'; then
      if [ -f "$RUN/ip_forward" ]; then
        cat "$RUN/ip_forward" > /proc/sys/net/ipv4/ip_forward
        rm -f "$RUN/ip_forward"
      fi
    fi
    ;;
  *) echo "usage: $0 start|stop <iface>" >&2; exit 2 ;;
esac
