#!/bin/sh
# APPLaunch entry point for TNT WiFi Share (also installed as
# /usr/bin/tnt-wifi-share for use over SSH: tnt-wifi-share --status).
# APPLaunch runs Exec without a shell, so environment setup lives here.
APP_DIR=/usr/share/APPLaunch/lib/tnt-wifi-share
export PYTHONPATH="$APP_DIR${PYTHONPATH:+:$PYTHONPATH}"
export PYGAME_HIDE_SUPPORT_PROMPT=1 SDL_VIDEODRIVER=dummy SDL_AUDIODRIVER=dummy
export PATH="${PATH:-/usr/bin:/bin}:/usr/sbin:/sbin"
[ -z "$XDG_RUNTIME_DIR" ] && export XDG_RUNTIME_DIR="/run/user/$(id -u)"
cd "$APP_DIR" || exit 1

# Command-line use: pass straight through.
if [ $# -gt 0 ]; then
  exec python3 -m tntshare "$@"
fi

python3 -m tntshare &
child=$!
# Forward a stop from the launcher to the app (it restores the network).
trap 'kill -TERM "$child" 2>/dev/null' TERM INT HUP
wait "$child"
status=$?
while kill -0 "$child" 2>/dev/null; do wait "$child"; status=$?; done
# Safety net: if the app died without cleaning up, undo its changes now.
python3 -m tntshare --restore >/dev/null 2>&1
exit $status
