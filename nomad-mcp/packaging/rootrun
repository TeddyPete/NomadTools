#!/bin/sh
# Nomad MCP: run one command as root for the connected AI app.
# The nomad-mcp server only calls this (through "sudo -n") while
# Nomad MCP > Permissions > Admin (sudo) is switched on at the device.
# /etc/sudoers.d/nomad-mcp lets the pi user run this file without a password.
[ -n "$1" ] || { echo "usage: rootrun 'command'" >&2; exit 2; }
export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
export DEBIAN_FRONTEND=noninteractive
logger -t nomad-mcp "root command: $1" 2>/dev/null || true
exec /bin/bash -c "$1"
