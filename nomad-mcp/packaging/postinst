#!/bin/sh
set -e
case "$1" in
  configure)
    # validate the sudoers drop-in; remove it if sudo would reject it
    if command -v visudo >/dev/null 2>&1 && ! visudo -cf /etc/sudoers.d/nomad-mcp >/dev/null 2>&1; then
      echo "nomad-mcp: sudoers file failed validation, removing it" >&2
      rm -f /etc/sudoers.d/nomad-mcp
    fi
    [ -d /run/systemd/system ] && systemctl --global daemon-reload >/dev/null 2>&1 || true
    # reload pi's user manager so the new unit is seen, and restart the server if it is on
    if id pi >/dev/null 2>&1 && [ -S /run/user/$(id -u pi)/bus ]; then
      R="XDG_RUNTIME_DIR=/run/user/$(id -u pi)"
      su pi -s /bin/sh -c "$R systemctl --user daemon-reload; $R systemctl --user try-restart nomad-mcp.service" >/dev/null 2>&1 || true
    fi
    ;;
esac
exit 0
