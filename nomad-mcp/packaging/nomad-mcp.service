# Nomad MCP server (user service of the pi user; starts at boot through
# lingering when switched On in the Nomad MCP app).
[Unit]
Description=Nomad MCP (MCP server for the CardputerZero)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/nomad-mcp --serve
Restart=on-failure
RestartSec=5
Nice=5

[Install]
WantedBy=default.target
