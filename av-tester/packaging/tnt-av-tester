#!/bin/sh
# APPLaunch entry point for the TNT AV Tester.
# APPLaunch runs Exec without a shell, so environment setup lives here.
#
# Desktop handling: if the Pi desktop (lightdm) is running on HDMI, it owns
# the display and the tester can't set HDMI modes. So we pause the desktop
# while the tester runs and start it again when the tester exits. A reboot
# also brings the desktop back, because nothing is disabled permanently.
# Pausing uses a polkit rule shipped with this package that lets the local
# user stop/start lightdm.service only. Set ZEROAV_KEEP_DESKTOP=1 to skip.
APP_DIR=/usr/share/APPLaunch/lib/tnt-av-tester
cd "$APP_DIR" || exit 1
export PYTHONPATH="$APP_DIR${PYTHONPATH:+:$PYTHONPATH}"
[ -z "$XDG_RUNTIME_DIR" ] && export XDG_RUNTIME_DIR="/run/user/$(id -u)"
export PYGAME_HIDE_SUPPORT_PROMPT=1
# card0 is the HDMI (vc4) output; card1 is the built-in LCD panel
export SDL_KMSDRM_DEVICE_INDEX="${SDL_KMSDRM_DEVICE_INDEX:-0}"

DM=lightdm.service
paused=0
if [ "${ZEROAV_KEEP_DESKTOP:-0}" != 1 ] && systemctl is-active --quiet "$DM" 2>/dev/null; then
  if systemctl --no-ask-password stop "$DM" 2>/dev/null; then
    paused=1
    echo "tnt-av-tester: desktop paused" >&2
    # let the compositor release HDMI
    i=0
    while [ $i -lt 20 ] && pgrep -x labwc >/dev/null 2>&1; do sleep 0.25; i=$((i + 1)); done
  else
    echo "tnt-av-tester: could not pause desktop; using a window on it" >&2
  fi
fi

restore() {
  if [ "$paused" = 1 ]; then
    paused=0
    systemctl --no-ask-password start "$DM" 2>/dev/null \
      && echo "tnt-av-tester: desktop restored" >&2
  fi
}
trap restore EXIT

# Pick how to reach HDMI: directly (KMS/DRM) when nothing else owns it,
# otherwise a fullscreen window on the running desktop.
if [ -z "$SDL_VIDEODRIVER" ]; then
  if [ "$paused" = 0 ] && [ -S "$XDG_RUNTIME_DIR/${WAYLAND_DISPLAY:-wayland-0}" ] && pgrep -x labwc >/dev/null 2>&1; then
    export WAYLAND_DISPLAY="${WAYLAND_DISPLAY:-wayland-0}" SDL_VIDEODRIVER=wayland
  elif [ "$paused" = 0 ] && [ -S /tmp/.X11-unix/X0 ] && pgrep -x Xorg >/dev/null 2>&1; then
    export DISPLAY="${DISPLAY:-:0}" SDL_VIDEODRIVER=x11
  else
    export SDL_VIDEODRIVER=kmsdrm
  fi
fi

python3 -m zeroav.app "$@" &
child=$!
# Forward a stop from the launcher to the app, then fall through to restore.
trap 'kill -TERM "$child" 2>/dev/null' TERM INT HUP
wait "$child"
status=$?
# wait returns early when a trapped signal arrives; wait again for the app
while kill -0 "$child" 2>/dev/null; do wait "$child"; status=$?; done
exit $status
