// Nomad AV Tester: let local users in the "video" group stop and
// start the desktop (lightdm.service) without a password, so the tester can
// pause the desktop while it drives HDMI and restore it on exit.
// Nothing else is allowed: other units and other verbs are untouched.
polkit.addRule(function (action, subject) {
  if (action.id == "org.freedesktop.systemd1.manage-units" &&
      action.lookup("unit") == "lightdm.service" &&
      (action.lookup("verb") == "stop" || action.lookup("verb") == "start") &&
      subject.isInGroup("video")) {
    return polkit.Result.YES;
  }
});
