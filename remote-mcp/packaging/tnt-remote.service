# TNT Remote server (user service of the pi user; starts at boot through
# lingering when switched On in the TNT Remote app).
[Unit]
Description=TNT Remote (Claude connector for the CardputerZero)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/tnt-remote --serve
Restart=on-failure
RestartSec=5
Nice=5

[Install]
WantedBy=default.target
